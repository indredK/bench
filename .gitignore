# Auto-generated by Tauri build (capability schema)
src-tauri/gen/

# Extension build artifacts (vite outDir) — deploy to runtime via
# `pnpm run extensions:sync`; sources (src/, index.html, locales/, manifest.json)
# stay tracked. Roadmap P3.4: 产物不进 git。
extensions/*/assets/

# Bundled-extension staging for `tauri build` resources (generated by
# `pnpm run extensions:stage`, see scripts/plugins/stage-bundled-extensions.mjs).
# 仅忽略 staging 生成物目录；src-tauri/resources/browser-extension/ 是
# bench-companion 扩展模板**源文件**（include_str! 编译期嵌入，见
# src-tauri/src/browser_ext/mod.rs），必须保持跟踪。
src-tauri/resources/extensions/

# bench-host sidecar 产物（scripts/plugins/build-bench-host.mjs 生成，
# beforeBuildCommand 自动构建，产物不进 git）
src-tauri/binaries/

