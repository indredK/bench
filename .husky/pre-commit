#!/usr/bin/env sh

set -e

# Git hooks run in a stripped, non-interactive environment where fnm (and thus the
# project's required node >=24) is not on PATH. `.zshrc`'s `fnm env` is never
# sourced here, so `node` would fall back to the hermes v22 symlink and trip the
# `engines.node >=24` guard. Resolve node via fnm's default version (currently
# v26.4.0) so the quality tooling runs on a supported node. Fall back to common
# install locations if fnm is unavailable. Order matters: fnm node must win.
FNM_DEFAULT="$(/opt/homebrew/bin/fnm default 2>/dev/null)"
FNM_NODE_BIN="$HOME/.local/share/fnm/node-versions/$FNM_DEFAULT/installation/bin"
BASE_TOOLS="$HOME/.hermes/node/bin:$HOME/.local/bin:$HOME/.local/bin-wb:/Users/apple/.cargo/bin:/usr/local/bin:/opt/homebrew/bin"
if [ -n "$FNM_DEFAULT" ] && [ -d "$FNM_NODE_BIN" ]; then
  export PATH="$FNM_NODE_BIN:$BASE_TOOLS:$PATH"
else
  export PATH="$BASE_TOOLS:$PATH"
fi

# Dispatch the pre-commit gate to Lefthook (replaces the custom
# scripts/quality/pre-commit-check.mjs orchestrator). Lefthook reads
# lefthook.yml from the repo root, runs staged-file-scoped auto-fixes, and
# re-stages fixed files before the read-only guards.
node node_modules/lefthook/bin/index.js run pre-commit
