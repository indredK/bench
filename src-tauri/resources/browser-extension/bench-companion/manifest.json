{
  "manifest_version": 3,
  "name": "Bench Companion",
  "version": "0.4.0",
  "description": "Bench 能力出口：在浏览器中调用 Bench 的术语库 / 存储扫描 / 照片筛选能力，并把日常浏览器里已登录的站点会话安全地交给 Bench（经本机 bridge）；也可把 Bench 账号的登录态（Cookie + 本地存储）自动注入本站点。",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bench Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "tab.html",
  "permissions": ["nativeMessaging", "storage", "cookies", "activeTab", "scripting", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "bench-companion@kindred.dev",
      "strict_min_version": "128.0"
    }
  }
}
