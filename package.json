{
  "name": "bench",
  "private": true,
  "version": "1.28.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "setup": "node scripts/bootstrap/setup.mjs",
    "clean": "node scripts/bootstrap/clean.mjs",
    "start": "node scripts/bootstrap/menu.mjs",
    "setup:unix": "node scripts/bootstrap/setup.mjs",
    "check:precommit": "node scripts/quality/pre-commit-check.mjs",
    "commitlint": "node scripts/quality/commit-msg-check.mjs",
    "hooks:install": "node scripts/bootstrap/install-hooks.mjs",
    "prepare": "node scripts/bootstrap/install-hooks.mjs",
    "postinstall": "node scripts/bootstrap/install-hooks.mjs",
    "check:i18n": "node scripts/quality/check-i18n-guards.mjs",
    "check:ci-platforms": "node scripts/quality/check-ci-platforms.mjs",
    "check:be-cfg": "node scripts/quality/check-rust-cfg-hygiene.mjs",
    "fix:be-cfg": "node scripts/quality/check-rust-cfg-hygiene.mjs --fix",
    "dev:fe": "vite",
    "build:fe": "tsc && vite build",
    "preview:fe": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fe": "pnpm run check:i18n && pnpm run check:docs && pnpm run check:ci-platforms && tsc --noEmit",
    "check:docs": "node scripts/quality/check-docs-consistency.mjs && node scripts/quality/check-markdown-links.mjs",
    "test:fe": "vitest run",
    "test:fe:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:critical": "vitest run src/features/account-manager src/features/token-calculator src/features/app-manager src/features/quick-launch src/features/updater src/features/system-settings src/features/registry.test.tsx src/shared/app-inventory src/components/__tests__/ContentView.test.tsx src/components/common/__tests__/SettingsDialog.test.tsx src/components/common/__tests__/UpdateDialog.test.tsx scripts/quality/__tests__ scripts/release/__tests__/verify-release-assets.test.ts",
    "test:be": "cd src-tauri && cargo test",
    "check:be": "cd src-tauri && cargo check",
    "clippy:be": "cd src-tauri && cargo clippy -- -D warnings",
    "format:be": "cd src-tauri && cargo fmt --all -- --check",
    "clean:be": "cd src-tauri && cargo clean",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "test": "pnpm run test:fe && pnpm run test:be",
    "diagrams": "node docs/diagrams/server.mjs",
    "verify": "pnpm run format:check && pnpm run lint:fe && pnpm run check:be-cfg && pnpm run test:fe && pnpm run format:be && pnpm run clippy:be && pnpm run test:be && pnpm run build:fe && pnpm run build:debug",
    "ci": "pnpm install --frozen-lockfile && pnpm run verify",
    "upgrade:safe": "node scripts/maintenance/safe-upgrade.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.40.0",
    "motion": "^13.2.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "wouter": "^3.10.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@clack/prompts": "^1.7.0",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
