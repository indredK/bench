{
  "schemaVersion": 2,
  "id": "clean-space",
  "version": "1.0.0",
  "display": {
    "zh": "存储空间",
    "en": "Clean Space"
  },
  "distribution": "bundled",
  "entry": {
    "index": "index.html"
  },
  "acl": {
    "commands": [
      "scan_storage_overview",
      "scan_storage_stream",
      "get_category_items",
      "execute_category_cleanup",
      "scan_custom_folder",
      "open_system_storage_settings",
      "get_cleanup_records",
      "add_cleanup_record",
      "scan_dev_projects",
      "cleanup_projects",
      "stop_scan",
      "get_custom_cleanup_commands",
      "execute_custom_cleanup",
      "stop_custom_cleanup"
    ]
  },
  "engines": {
    "bench": ">=1.30.0"
  },
  "platforms": ["macos"]
}
